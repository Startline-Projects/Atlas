# =============================================================================
# Atlas — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Every variable here is validated by `src/lib/config/env.ts` at startup.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Dashboard settings the candidate signup flow depends on:
#   Authentication → Sign In / Providers → Email → "Confirm email" ON.
#   Authentication → Emails → "Confirm signup" template must contain
#   {{ .Token }} — the signup form asks for a 6-digit code, not a link.
#   (Editing templates requires custom SMTP on Supabase — e.g. Resend.)
#
# Temporary bypass until that is set up: with this set, signup sends no email
# and /verify-email accepts exactly this code for every account. Unset it to
# switch back to the real Supabase OTP flow — no code change needed.
# AUTH_DEV_FIXED_OTP="111111"

# --- Database (Prisma) -------------------------------------------------------
# Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL  = Transaction pooler (port 6543) — used by the running app.
# DIRECT_URL    = Direct connection (port 5432) — used by migrations only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# =============================================================================
# Not yet wired — add as each integration lands (see docs/TECH_STACK.md)
# =============================================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# PUSHER_APP_ID=
# PUSHER_SECRET=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
